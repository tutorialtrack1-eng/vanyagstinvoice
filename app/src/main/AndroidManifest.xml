<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Used only to look up bank name and branch from an IFSC code -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Android 11+ only lets the app see UPI, browser and SMS apps that are declared here -->
    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="upi" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
        <intent>
            <action android:name="android.intent.action.SENDTO" />
            <data android:scheme="smsto" />
        </intent>
    </queries>
    <application
        android:allowBackup="true"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity android:name=".LoginActivity" android:screenOrientation="portrait" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity android:name=".RegisterActivity" android:screenOrientation="portrait" />

        <activity android:name=".MainActivity" android:screenOrientation="portrait" android:exported="true" />

    </application>
</manifest>
